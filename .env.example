SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
REDUCTO_API_KEY=your-reducto-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
COHERE_API_KEY=your-cohere-api-key
EMBEDDING_MODEL=embed-v5.0-pro
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=claude-sonnet-4-6
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=40
RERANK_TOP_N=8
RERANK_MODEL=rerank-v3.5
# After an embedding rate-limit error: wait this long, then retry the batch, at most this often.
EMBED_RATE_LIMIT_WAIT_SECONDS=61
EMBED_RATE_LIMIT_RETRIES=5
# A source not confirmed by a person for longer than this is flagged overdue.
CONFIRMATION_MAX_AGE_DAYS=180
